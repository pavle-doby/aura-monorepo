      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-navigation/native": "^7.0.0",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19",
    "typescript": "^5"
  }
