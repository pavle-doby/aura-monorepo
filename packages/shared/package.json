{
  "name": "@repo/shared",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./hooks": "./src/hooks/index.ts",
    "./consts": "./src/consts/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19",
    "eslint": "^9",
    "react": "19.2.0",
    "typescript": "^5",
    "lint-staged": "^17.0.7"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "pnpm exec prettier --write"
    ],
    "**/*.{md,json}": [
      "pnpm exec prettier --write"
    ]
  }
}
