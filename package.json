{
  "name": "aura",
  "private": true,
  "scripts": {
    "api": "cd apps/api && pnpm dev",
    "web": "cd apps/web && pnpm dev",
    "ios": "cd apps/native && pnpm ios:15",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && pnpm drizzle-kit generate",
    "db:push": "cd packages/db && pnpm drizzle-kit push",
    "db:migrate": "cd packages/db && pnpm drizzle-kit migrate",
    "db:studio": "cd packages/db && pnpm drizzle-kit studio",
    "db:clean:users": "pnpm --filter @repo/scripts db:clean:users",
    "db:seed:users": "pnpm --filter @repo/scripts db:seed:users",
    "api-client:generate": "turbo run generate:openapi generate:api"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "turbo": "^2.9.16",
    "typescript": "5.9.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=20"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~55.0.26",
    "react": "19.2.0",
    "react-native": "0.83.6"
  }
}
